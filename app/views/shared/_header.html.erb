<header class="border-b-2 border-b-[#E9E1D4]" data-controller="header">
  <div class="max-w-7xl mx-auto px-4 py-4
              flex justify-between items-center
              text-brown relative">

    <!-- ロゴ -->
    <%= link_to root_path do %>
      <h1 class="text-lg font-kaisei_decol font-bold">
        老犬くらぶ
      </h1>
    <% end %>

    <!-- 右側エリア -->
    <div class="flex items-center gap-6">

      <!-- テキストナビ（PC用・そのまま表示） -->
      <ul class="hidden md:flex items-center gap-6 list-none">
        <% if user_signed_in? %>
          <li>
            <%= link_to "ログアウト",
                  destroy_user_session_path,
                  data: { turbo_method: :delete } %>
          </li>
        <% else %>
          <li>
            <%= link_to "新規登録", new_user_registration_path %>
          </li>
          <li>
            <%= link_to "ログイン", new_user_session_path %>
          </li>
        <% end %>
      </ul>

      <!-- ハンバーガーメニュー -->
      <nav class="relative">
        <button
          type="button"
          data-action="click->header#toggleMenu"
          class="z-50 p-2"
        >
          <i data-header-target="bars" class="fa-solid fa-bars fa-2x"></i>
          <i data-header-target="xmark" class="fa-solid fa-xmark fa-2x hidden"></i>
        </button>

        <!-- ハンバーガーメニュー中身（PCでも表示） -->
        <ul
          data-header-target="menu"
          class="
            absolute top-16 right-0
            w-48
            bg-ivory
            border-2 border-brown
            rounded-xl
            shadow-lg
            hidden
            transition-transform duration-300
            z-40
          "
        >
          <li class="px-4 py-3 border-b border-brown">
            <%= link_to 'トップ', root_path %>
          </li>

          <li class="px-4 py-3 border-b border-brown">
            <%= link_to '質問一覧', questions_path %>
          </li>

          <li class="px-4 py-3">
            <%= link_to 'マイページ', mypage_path %>
          </li>
        </ul>
      </nav>

    </div>
  </div>
</header>
