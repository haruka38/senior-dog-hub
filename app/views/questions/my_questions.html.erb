<div class="max-w-3xl mx-auto px-4 sm:px-6 my-6 text-brown">

  <h1 class="text-xl sm:text-2xl font-bold mb-6 text-center sm:text-left">
    自分の質問一覧
  </h1>

  <% if @questions.any? %>
    <% @questions.each do |question| %>

      <div class="
        bg-ivory
        border-2 border-transparent
        hover:border-brown hover:shadow
        rounded-xl transition
        px-4 py-4 sm:px-6 sm:py-6
        mb-6
      ">

        <%= link_to question_path(question),
              class: "block",
              data: { turbo_frame: "_top" } do %>

          <!-- 上段：ユーザー情報 -->
          <div class="flex flex-col sm:flex-row sm:justify-between gap-2 text-sm">
            <div class="flex flex-wrap gap-x-4 gap-y-1">
              <p><%= question.nickname.presence || "匿名さん" %></p>
              <p><%= question.age.present? ? "#{question.age}歳" : "" %></p>
              <p><%= question.breed&.name %></p>
            </div>

            <p class="text-gray-500 text-xs sm:text-sm">
              <%= question.created_at.strftime('%Y/%m/%d') %>
            </p>
          </div>

          <!-- 本文 -->
          <p class="mt-3 text-sm sm:text-base leading-relaxed">
            <%= question.body %>
          </p>
        <% end %>

        <!-- スタンプ -->
        <div id="stamps_<%= question.id %>" class="mt-3">
          <%= render partial: "stamps/stamp_buttons",
                locals: {
                  stampable: question,
                  stamp_types: @question_stamp_types
                } %>
        </div>

      </div>

    <% end %>

  <% else %>
    <p class="text-center text-gray-500 mt-10">
      まだ質問はありません。
    </p>
  <% end %>
</div>
