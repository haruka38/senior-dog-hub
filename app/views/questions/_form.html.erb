<div class="max-w-2xl mx-auto px-4 sm:px-6 mt-6 text-brown">

  <h2 class="text-xl sm:text-2xl font-bold mb-6 text-center sm:text-left">
    <%= @question.new_record? ? "質問する" : "質問を編集する" %>
  </h2>

  <div class="bg-ivory border rounded-xl px-4 py-6 sm:px-6 sm:py-8 shadow-sm">
    <%= form_with model: @question do |f| %>

      <!-- 質問内容 -->
      <div class="mb-6">
        <%= f.label :body, "質問内容", class: "block font-bold mb-2" %>
        <%= f.text_area :body,
              rows: 5,
              placeholder: "例：最近歩くのがゆっくりです…",
              class: "w-full border rounded p-3 text-sm sm:text-base focus:outline-none focus:ring-2 focus:ring-beige" %>
      </div>

      <!-- ニックネーム -->
      <div class="mb-6">
        <%= f.label :nickname, "ニックネーム", class: "block font-bold mb-2" %>
        <%= f.text_field :nickname,
              placeholder: "未入力でもOKです！",
              class: "w-full border rounded p-3 text-sm sm:text-base" %>
      </div>

      <!-- 犬種 -->
      <div class="mb-6">
        <%= f.label :breed_id, "犬種", class: "block font-bold mb-2" %>
        <%= f.collection_select :breed_id,
              Breed.all, :id, :name,
              { include_blank: "未入力でもOKです！" },
              class: "w-full border rounded p-3 text-sm sm:text-base bg-white" %>
      </div>

      <!-- 年齢 -->
      <div class="mb-6">
        <%= f.label :age, "年齢", class: "block font-bold mb-2" %>
        <%= f.number_field :age,
              placeholder: "例：13（未入力でもOK）",
              class: "w-full border rounded p-3 text-sm sm:text-base" %>
      </div>

      <!-- タグ -->
      <div class="mb-8">
        <%= f.label :tag_ids, "タグ", class: "block font-bold mb-2" %>
        <%= f.collection_select :tag_ids,
              @tags, :id, :name,
              { include_blank: "Ctrl / ⌘ を押しながら複数選択できます" },
              { multiple: true,
                class: "w-full border rounded p-3 text-sm sm:text-base bg-white h-32" } %>
      </div>

      <!-- 送信 -->
      <div class="text-center sm:text-left">
        <%= f.submit @question.new_record? ? "質問する" : "更新する",
              class: "bg-brown text-ivory font-bold py-3 px-8 rounded hover:opacity-90 w-full sm:w-auto" %>
      </div>

    <% end %>
  </div>
</div>
