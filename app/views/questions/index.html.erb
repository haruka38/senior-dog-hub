<div>
  <!-- 質問するボタン -->
  <%= link_to '質問する',
    new_question_path,
    class: "
      fixed bottom-6 right-4 sm:right-8
      py-4 px-6 sm:py-6 sm:px-10
      bg-green text-light-brown
      text-base sm:text-xl font-bold
      rounded-xl shadow-lg z-50
    " %>

  <!-- 検索フォーム -->
  <%= turbo_frame_tag "search_form" do %>
    <%= search_form_for @search,
          url: questions_path,
          data: { turbo_method: :get, turbo_frame: "questions" },
          local: false do |f| %>

      <div class="flex justify-center mt-4 px-4">
        <div class="flex flex-col sm:flex-row gap-3 items-stretch sm:items-center w-full sm:w-auto">

          <%= f.search_field :body_cont,
            placeholder: "ワード",
            class: "border border-beige rounded-md p-2 w-full sm:w-40" %>

          <%= f.collection_select :breed_id_eq,
            Breed.all, :id, :name,
            { prompt: "犬種" },
            class: "border border-beige rounded-md p-2 w-full sm:w-40 bg-white text-gray-400",
            onchange: "this.classList.remove('text-gray-400')" %>

          <%= f.collection_select :tags_id_eq,
            Tag.all, :id, :name,
            { prompt: "タグ" },
            class: "border border-beige rounded-md p-2 w-full sm:w-40 bg-white text-gray-400",
            onchange: "this.classList.remove('text-gray-400')" %>

          <%= f.submit "検索",
            class: "bg-light-brown text-white px-4 py-2 rounded-md w-full sm:w-auto" %>

          <%= link_to "クリア", questions_path,
            data: { turbo_frame: "_top" },
            class: "text-blue-600 underline text-center sm:text-left" %>
        </div>
      </div>

    <% end %>
  <% end %>

  <!-- 質問一覧 -->
  <%= turbo_frame_tag "questions" do %>

    <% if params.dig(:q, :body_cont).present? %>
      <div class="bg-red-50 p-2 text-sm max-w-3xl mx-auto mt-2">
        類似検索 件数: <%= @similar_questions.size %>
      </div>
    <% end %>

    <% if @similar_questions.present? %>
      <div class="bg-yellow-50 border rounded p-4 mb-6 max-w-3xl mx-auto">
        <p class="font-bold mb-2">もしかして、こちらの質問ですか？</p>
        <ul class="space-y-2">
          <% @similar_questions.each do |q| %>
            <li>
              <%= link_to q.body.truncate(40), question_path(q),
                    data: { turbo_frame: "_top" },
                    class: "text-blue-600 underline" %>
            </li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div class="max-w-3xl mx-auto px-4 sm:px-6 my-6">

      <% @questions.each do |question| %>
        <div class="
          bg-ivory text-brown
          border-2 border-transparent
          hover:border-brown hover:shadow
          rounded-xl transition
          px-4 py-4 sm:px-6 sm:py-6
          mb-6
        ">

          <%= link_to question_path(question),
                class: "block",
                data: { turbo_frame: "_top" } do %>

            <div class="flex flex-col sm:flex-row sm:justify-between gap-2 text-sm">
              <div class="flex flex-wrap gap-x-4 gap-y-1">
                <p><%= question.nickname.presence || "匿名さん" %></p>
                <p><%= question.age.present? ? "#{question.age}歳" : "" %></p>
                <p><%= question.breed&.name %></p>
              </div>

              <p class="text-gray-500 text-xs sm:text-sm">
                <%= question.created_at.strftime('%Y/%m/%d') %>
              </p>
            </div>

            <p class="mt-3 text-sm sm:text-base leading-relaxed">
              <%= question.body %>
            </p>
          <% end %>

          <!-- スタンプ -->
          <div id="stamps_<%= question.id %>" class="mt-3">
            <%= render "stamps/stamp_buttons",
                  stampable: question,
                  stamp_types: @question_stamp_types %>
          </div>
        </div>
      <% end %>

      <div class="flex justify-center my-8">
        <%= paginate @questions %>
      </div>
    </div>
  <% end %>
</div>
